# Copy to .env and replace the two secret placeholders. Do not commit .env.
LAN_BIND=127.0.0.1
DB_PASSWORD=replace-with-a-long-random-alphanumeric-password
CREDENTIAL_KEY=replace-with-64-random-hex-characters
OLLAMA_URL=http://host.docker.internal:11434/
OLLAMA_MODEL=qwen3-coder:30b
# Optional: server-side only; leave blank for Ollama-only runs.
OPENROUTER_API_KEY=
