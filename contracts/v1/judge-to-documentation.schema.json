{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "const": "judge_to_documentation"
        },
        "status": {
          "type": "string",
          "const": "ok"
        },
        "header": {
          "type": "object",
          "properties": {
            "version": {
              "type": "number",
              "const": 1
            },
            "messageId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "parentMessageId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "caseId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "attemptId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "version",
            "messageId",
            "parentMessageId",
            "runId",
            "caseId",
            "attemptId"
          ],
          "additionalProperties": false
        },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "findingId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "basis": {
                  "type": "string",
                  "const": "auto_confirmed"
                },
                "sourceOutcome": {
                  "type": "string",
                  "const": "auto_confirm"
                },
                "evidenceRefs": {
                  "minItems": 1,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "runId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "attemptId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "ref": {
                        "type": "string",
                        "pattern": "^turn-[1-3]$"
                      },
                      "observationVersion": {
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 1
                          },
                          {
                            "type": "number",
                            "const": 2
                          }
                        ]
                      },
                      "completeness": {
                        "type": "string",
                        "enum": [
                          "complete",
                          "partial",
                          "truncated",
                          "unknown"
                        ]
                      },
                      "targetTurnId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    },
                    "required": [
                      "runId",
                      "attemptId",
                      "ref",
                      "observationVersion",
                      "completeness"
                    ],
                    "additionalProperties": false
                  }
                },
                "policy": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "number",
                      "const": 2
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "safe",
                        "inconclusive",
                        "pending_review",
                        "auto_confirm",
                        "blocked",
                        "incomplete"
                      ]
                    },
                    "passed": {
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 80
                      }
                    },
                    "failed": {
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 80
                      }
                    },
                    "canonicalClaim": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "version",
                    "outcome",
                    "passed",
                    "failed"
                  ],
                  "additionalProperties": false
                },
                "regression": {
                  "type": "string",
                  "enum": [
                    "new",
                    "recurring",
                    "fixed",
                    "resurfaced",
                    "unknown",
                    "not_applicable"
                  ]
                }
              },
              "required": [
                "findingId",
                "basis",
                "sourceOutcome",
                "evidenceRefs",
                "policy",
                "regression"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "findingId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "basis": {
                  "type": "string",
                  "const": "human_confirmed"
                },
                "sourceOutcome": {
                  "type": "string",
                  "const": "pending_review"
                },
                "evidenceRefs": {
                  "minItems": 1,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "runId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "attemptId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "ref": {
                        "type": "string",
                        "pattern": "^turn-[1-3]$"
                      },
                      "observationVersion": {
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 1
                          },
                          {
                            "type": "number",
                            "const": 2
                          }
                        ]
                      },
                      "completeness": {
                        "type": "string",
                        "enum": [
                          "complete",
                          "partial",
                          "truncated",
                          "unknown"
                        ]
                      },
                      "targetTurnId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    },
                    "required": [
                      "runId",
                      "attemptId",
                      "ref",
                      "observationVersion",
                      "completeness"
                    ],
                    "additionalProperties": false
                  }
                },
                "policy": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "number",
                      "const": 2
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "safe",
                        "inconclusive",
                        "pending_review",
                        "auto_confirm",
                        "blocked",
                        "incomplete"
                      ]
                    },
                    "passed": {
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 80
                      }
                    },
                    "failed": {
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 80
                      }
                    },
                    "canonicalClaim": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "version",
                    "outcome",
                    "passed",
                    "failed"
                  ],
                  "additionalProperties": false
                },
                "regression": {
                  "type": "string",
                  "enum": [
                    "new",
                    "recurring",
                    "fixed",
                    "resurfaced",
                    "unknown",
                    "not_applicable"
                  ]
                }
              },
              "required": [
                "findingId",
                "basis",
                "sourceOutcome",
                "evidenceRefs",
                "policy",
                "regression"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "channel",
        "status",
        "header",
        "payload"
      ],
      "additionalProperties": false
    },
    {
