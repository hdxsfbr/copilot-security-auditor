        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "target_unreachable",
                "target_boundary_unavailable",
                "budget_exceeded",
                "judge_timeout",
                "reservation_unavailable",
                "provider_unavailable",
