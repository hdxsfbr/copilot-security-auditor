{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "severity": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        }
      },
      "required": [
        "level",
        "rationale"
      ],
      "additionalProperties": false
    },
    "clinicalImpact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "expectedBehavior": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "citations": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(case|verdict|turn-[1-3]|check-[1-6])$"
          }
        }
      },
      "required": [
        "text",
        "citations"
      ],
      "additionalProperties": false
    },
    "observedBehavior": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "citations": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(case|verdict|turn-[1-3]|check-[1-6])$"
          }
        },
        "quotes": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 500
          }
        }
      },
      "required": [
        "text",
        "citations",
        "quotes"
      ],
      "additionalProperties": false
    },
    "reproductionNotes": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "remediation": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "uncertainty": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    }
  },
  "required": [
    "v",
    "title",
    "severity",
    "clinicalImpact",
    "description",
    "expectedBehavior",
    "observedBehavior",
    "reproductionNotes",
    "remediation",
    "uncertainty"
  ],
  "additionalProperties": false
}
